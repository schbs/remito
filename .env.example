# Remito (demo): todas las variables, con valores falsos. Los valores reales van en .env.local (lo completa Germán).
# Ver qué falta sin mostrar valores: npm run check-env
# La demo (npm run dev, npm start y cualquier deploy) no usa ninguna: corre con las respuestas grabadas.

# Gemini (aistudio.google.com → Get API key): extracción con visión. Solo para medir (npm run accuracy) o el modo real.
GEMINI_API_KEY=pon-aca-tu-clave
GEMINI_MODEL=gemini-3.5-flash-lite

# Modo real (solo en la PC, npm run dev:real): Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth,
# tipo "App de escritorio", con Gmail API y Google Sheets API habilitadas y la casilla de demo como usuario de prueba.
GOOGLE_CLIENT_ID=pon-aca-el-id-del-cliente
GOOGLE_CLIENT_SECRET=pon-aca-el-secreto-del-cliente
# Lo completa `npm run google:autorizar` (no se copia a mano).
GOOGLE_REFRESH_TOKEN=
# La casilla de demo autorizada (también la completa el script): el único destino de los mails de prueba.
GMAIL_DEMO=
# Lo completa `npm run planilla:crear`.
GOOGLE_SHEET_ID=
